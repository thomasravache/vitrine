<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>vitrine-apphost</UserSecretsId>
    <!-- ASPIRE010 suprimido: DCP e dashboard vêm dos pacotes NuGet (AspireUseCliBundle=false), para que
         build e testes (Aspire.Hosting.Testing) rodem no CI sem exigir o Aspire CLI instalado.
         `aspire run` continua funcionando com esta configuração. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\Vitrine.Api.csproj" />
    <!-- Simulador do Mercado Livre (SPEC-0024): recurso só em modo run (nunca no aspire publish). -->
    <ProjectReference Include="..\..\tools\MercadoLivreSimulator\Vitrine.MercadoLivreSimulator.csproj" />
  </ItemGroup>

</Project>
