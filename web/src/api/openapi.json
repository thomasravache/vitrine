  "components": {
    "schemas": {
      "CompleteConnectionRequest": {
        "required": ["code", "state"],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "ConnectedAccountResponse": {
        "required": ["accountId", "mlUserId", "nickname", "status"],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "mlUserId": {
            "type": "integer",
            "format": "int64"
          },
          "nickname": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ListingResponse": {
        "required": [
          "itemId",
          "accountId",
          "title",
          "price",
          "currencyId",
          "availableQuantity",
          "soldQuantity",
          "status",
          "permalink",
          "thumbnailUrl",
          "lastUpdated"
        ],
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "currencyId": {
            "type": "string"
          },
          "availableQuantity": {
            "type": "integer",
            "format": "int32"
          },
          "soldQuantity": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string"
          },
          "permalink": {
            "type": ["null", "string"]
          },
          "thumbnailUrl": {
            "type": ["null", "string"]
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ListingsAccountSummaryResponse": {
        "required": ["accountId", "itemCount", "syncStatus", "lastSyncedAt", "lastError"],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "itemCount": {
            "type": "integer",
            "format": "int32"
          },
          "syncStatus": {
            "type": "string"
          },
          "lastSyncedAt": {
            "type": ["null", "string"],
            "format": "date-time"
          },
          "lastError": {
            "type": ["null", "string"]
          }
        }
      },
      "ListingsByStatusResponse": {
        "required": ["active", "paused", "closed", "other"],
        "type": "object",
        "properties": {
          "active": {
            "type": "integer",
            "format": "int32"
          },
          "paused": {
            "type": "integer",
            "format": "int32"
          },
          "closed": {
            "type": "integer",
            "format": "int32"
          },
          "other": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ListingsPageResponse": {
        "required": ["items", "nextCursor"],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListingResponse"
            }
          },
          "nextCursor": {
            "type": ["null", "string"]
          }
        }
      },
      "ListingsSummaryResponse": {
        "required": ["total", "byStatus", "accounts"],
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "byStatus": {
            "$ref": "#/components/schemas/ListingsByStatusResponse"
          },
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListingsAccountSummaryResponse"
            }
          }
        }
      },
      "LoginRequest": {
        "required": ["email", "password"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MercadoLivreAccountResponse": {
        "required": ["accountId", "mlUserId", "nickname", "siteId", "status", "connectedAt"],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "mlUserId": {
            "type": "integer",
            "format": "int64"
          },
          "nickname": {
            "type": "string"
          },
          "siteId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "connectedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MeResponse": {
        "required": ["userId", "name", "email", "workspace"],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "workspace": {
            "$ref": "#/components/schemas/MeWorkspace"
          }
        }
      },
      "MeWorkspace": {
        "required": ["id", "name", "role"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": ["null", "string"]
          },
          "title": {
            "type": ["null", "string"]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "detail": {
            "type": ["null", "string"]
          },
          "instance": {
            "type": ["null", "string"]
          }
        }
      },
      "RegisterRequest": {
        "required": ["name", "email", "password"],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RegisterResponse": {
        "required": ["userId", "workspaceId"],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "StartConnectionResponse": {
        "required": ["authorizationUrl"],
        "type": "object",
        "properties": {
          "authorizationUrl": {
            "type": "string"
          }
        }
      },
      "SyncListingsRequest": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": ["null", "string"],
            "format": "uuid"
          }
        }
      },
      "SyncListingsResponse": {
        "required": ["queued"],
        "type": "object",
        "properties": {
          "queued": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Me"
    },
    {
      "name": "Auth"
    },
    {
      "name": "MercadoLivre"
    },
    {
      "name": "Listings"
    }
  ]
}
