<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Api\Vitrine.Api.csproj" />
    <!-- SPEC-0008: entidade de teste com campo IsProtected (IT-04/IT-05). -->
    <ProjectReference Include="..\..\src\Common\Vitrine.Common.Security\Vitrine.Common.Security.csproj" />
  </ItemGroup>

  <!-- Configuração de cobertura única (coverlet.MTP), mantida em Vitrine.UnitTests/testconfig.json. -->
  <ItemGroup>
    <None Include="..\Vitrine.UnitTests\testconfig.json" Link="$(AssemblyName).testconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Fixtures de resposta do ML no formato documentado, compartilhadas (SPEC-0024) pelos CT do gateway (SPEC-0021:CT-02),
       das notificações (SPEC-0023) e do simulador (SPEC-0024:CT-01); copiadas para MercadoLivre/Fixtures na saída. -->
  <ItemGroup>
    <None Include="..\Fixtures\MercadoLivre\**" LinkBase="MercadoLivre\Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Simulador do Mercado Livre (SPEC-0024) em WebApplicationFactory (IT-01, IT-02, IT-05, CT-01). -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\MercadoLivreSimulator\Vitrine.MercadoLivreSimulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
