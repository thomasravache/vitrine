# SPEC-0005 — ambiente local prod-like (Docker Compose + Caddy com CA interna).
# Só dados sintéticos; nenhum segredo real. Copie para deploy/local/.env e rode:
#   deploy/deploy.sh <tag> --env-file deploy/local/.env
# Endereço: https://vitrine.localhost (CA interna do Caddy; use curl -k ou confie na CA local).

# Perfil `db-container` sobe o PostgreSQL em container (produção usa o banco gerenciado).
# Perfil `ml-simulator` sobe o simulador do Mercado Livre (SPEC-0024, ADR-0016) em https://ml-simulador.vitrine.localhost;
# a imagem vitrine-ml-simulator:local é construída antes (docs/runbooks/deploy.md). Só o ambiente local liga este perfil.
COMPOSE_PROFILES=db-container,ml-simulator
# Sites extras do Caddy (relativo a deploy/): o do simulador. Sem esta linha, deploy/caddy-sites (vazio).
CADDY_EXTRA_SITES_DIR=./local/caddy-sites

# Repositório da imagem: vitrine-api (construída localmente) ou ghcr.io/thomasravache/vitrine-api.
IMAGE_REPO=vitrine-api

SITE_ADDRESS=vitrine.localhost
# Health check do deploy.sh aceita o certificado da CA interna do Caddy.
DEPLOY_HEALTH_INSECURE=true

ASPNETCORE_ENVIRONMENT=Production
# Cadastro público aberto no ambiente local prod-like (produção: false até o lançamento).
FEATURES_SIGNUP_OPEN=true
POSTGRES_PASSWORD=local-only-synthetic
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=vitrine;Username=vitrine;Password=local-only-synthetic

# Segurança (SPEC-0008). Chave mestra do Data Protection (DataProtection__MasterKey): 32 bytes em Base64.
# O valor abaixo é SINTÉTICO e público (decodifica para "local-only-synthetic-master-key!"): serve só para o ambiente
# local prod-like subir. Staging/produção: gere com `openssl rand -base64 32`, grave como secret do Environment e
# guarde uma cópia no cofre pessoal (docs/runbooks/rotacao-chave-mestra.md). Nunca reutilize este valor.
DATA_PROTECTION_MASTER_KEY=bG9jYWwtb25seS1zeW50aGV0aWMtbWFzdGVyLWtleSE=
# Só durante a rotação da chave mestra: a chave anterior (DataProtection__PreviousMasterKey). Vazia no resto do tempo.
DATA_PROTECTION_PREVIOUS_MASTER_KEY=
# Sub-rede da rede `proxy` do Compose (Caddy <-> Api); só dela a Api aceita X-Forwarded-For/Proto
# (ForwardedHeaders__KnownNetworks__0). Troque se colidir com outra rede do host.
PROXY_SUBNET=10.250.0.0/24
# Limites por minuto de /api/v1/auth/* (RateLimiting__AuthPerIp__PermitLimit e RateLimiting__LoginPerEmail__PermitLimit).
RATE_LIMIT_AUTH_PER_IP=10
RATE_LIMIT_LOGIN_PER_EMAIL=10
# Limite por minuto, por IP, do webhook de notificações do ML (RateLimiting__MercadoLivreNotificationsPerIp__PermitLimit).
RATE_LIMIT_ML_NOTIFICATIONS_PER_IP=600

# Mercado Livre (SPEC-0020) — no ambiente local, apontado para o simulador (SPEC-0024, perfil `ml-simulator`):
# o navegador abre a autorização em https://ml-simulador.vitrine.localhost (Caddy) e a Api fala com o simulador pela
# rede interna do Compose (http://ml-simulator:8080), o que exige ML_ALLOW_NON_OFFICIAL_ENDPOINTS=true em Production.
# ClientId/ClientSecret abaixo são SINTÉTICOS e públicos, compartilhados com o simulador (Simulator__ClientId/
# __ClientSecret no deploy/compose.override.yaml); nunca use aqui os do app real do DevCenter — esses são secrets do
# Environment (ADR-0006). Sem o simulador: esvazie ML_CLIENT_ID/ML_CLIENT_SECRET (conexão responde 503
# ML_NOT_CONFIGURED) ou use URLs vazias (= oficiais) com ML_ALLOW_NON_OFFICIAL_ENDPOINTS=false.
ML_CLIENT_ID=1000000000000024
ML_CLIENT_SECRET=simulador-local-sintetico-nao-secreto
ML_REDIRECT_URI=https://vitrine.localhost/contas/mercado-livre/retorno
ML_AUTHORIZATION_BASE_URL=https://ml-simulador.vitrine.localhost
ML_API_BASE_URL=http://ml-simulator:8080
ML_ALLOW_NON_OFFICIAL_ENDPOINTS=true
# Imagem do simulador (construída localmente; docs/runbooks/deploy.md). As notificações dele vão para o webhook da Api
# pela rede interna (Simulator__NotificationUrl no deploy/compose.override.yaml).
ML_SIMULATOR_IMAGE=vitrine-ml-simulator:local

# Observabilidade (SPEC-0007) — tudo opcional e vazio no ambiente local: sem estes valores a Api não exporta
# telemetria (só logs JSON no console) e o Sentry fica desligado. Valores reais são secrets do Environment
# (staging/production), gravados no deploy/.env (600) pelo pipeline — nunca neste arquivo (ADR-0006).
# Ambiente nos atributos de telemetria e no Sentry: local | staging | production.
DEPLOY_ENVIRONMENT=local
# OTLP do Grafana Cloud (ex.: https://otlp-gateway-<região>.grafana.net/otlp) e cabeçalho Authorization=Basic <base64>.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# DSN do Sentry do backend (o da SPA, VITE_SENTRY_DSN, entra no build da imagem).
SENTRY_DSN=
# Grafana Alloy (métricas do host): só com o perfil `observability` em COMPOSE_PROFILES e estas credenciais.
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_API_KEY=
